// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model FileMetadata {
  id           String   @id @default(uuid())
  originalName String
  filename     String
  mimetype     String
  size         Int
  url          String
  publicId     String
  folderPath   String?  // Tracks relative folder path if uploaded as a directory
  batchId      String?  // Groups files uploaded together in a single batch/folder operation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("file_metadata")
}